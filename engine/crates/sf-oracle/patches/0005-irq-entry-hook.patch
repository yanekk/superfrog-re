 {
     info.bind([this] { return cacheInfo(); } );
@@ -498,6 +502,7 @@ Blitter::prepareBlit()
 void
 Blitter::beginBlit()
 {
+    if (vamiga_blit_hook) vamiga_blit_hook(0, agnus.pos.v, agnus.pos.h);
     auto level = config.accuracy;
 
     if (bltconLINE()) {
@@ -591,6 +596,7 @@ Blitter::beginCopyBlit(isize level)
 void
 Blitter::clearBusyFlag()
 {
+    if (vamiga_blit_hook) vamiga_blit_hook(1, agnus.pos.v, agnus.pos.h);
     logmsg(LOG_BLTTIM, "(%td,%td) Blitter bbusy\n", agnus.pos.v, agnus.pos.h);
 
