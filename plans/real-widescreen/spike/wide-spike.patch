diff --git a/engine/crates/sf-core/src/spike.rs b/engine/crates/sf-core/src/spike.rs
new file mode 100644
index 0000000..d5b8609
--- /dev/null
+++ b/engine/crates/sf-core/src/spike.rs
@@ -0,0 +1,98 @@
+//! real-widescreen T00 spike: THROWAWAY. A global switch widening spawn/despawn by 65 px
+//! (DESIGN §2.2) and `EXTRA` extra object slots at an address the original never maps, plus
+//! counters the spike runner reads. Never committed.
+
+use std::sync::atomic::{AtomicBool, AtomicU32, Ordering::Relaxed};
+
+pub static WIDE: AtomicBool = AtomicBool::new(false);
+/// Set while an extra slot's work runs: its beam cost is skipped (DESIGN §2.4, D11).
+pub static FREE: AtomicBool = AtomicBool::new(false);
+
+pub const EXTRA: u32 = 100;
+/// Extra slots in use this run (at most `EXTRA`).
+pub static EXTRA_N: AtomicU32 = AtomicU32::new(60);
+
+pub fn extra() -> u32 {
+    EXTRA_N.load(Relaxed).min(EXTRA)
+}
+pub const WIDE_PX: u16 = 65;
+pub const WIDE_CELLS: u32 = 5;
+pub const BASE: u32 = 0x60_0000;
+pub const SLOTS_AT: u32 = BASE;
+pub const BOBS_AT: u32 = BASE + 0x4000;
+pub const FREE_AT: u32 = BASE + 0xb000;
+pub const BYTES: u32 = 0xb200;
+const _: () = assert!(EXTRA * 0x7c <= 0x4000 && EXTRA * 0x11c <= 0x7000 && EXTRA * 4 <= 0x200);
+
+/// Entries the last draw list held (spud, slot bobs, free bobs with something to erase).
+pub static DRAW: AtomicU32 = AtomicU32::new(0);
+/// Draw-list entries dropped because the list's 40 places were full.
+pub static DRAW_DROPPED: AtomicU32 = AtomicU32::new(0);
+/// Entries the last hitbox list held, and entries dropped at its 127.
+pub static HITBOXES: AtomicU32 = AtomicU32::new(0);
+pub static HITBOX_DROPPED: AtomicU32 = AtomicU32::new(0);
+/// `find_free` returning no slot; returning an evicted one.
+pub static FIND_FAIL: AtomicU32 = AtomicU32::new(0);
+pub static EVICT: AtomicU32 = AtomicU32::new(0);
+/// The coin's force-out of a non-evictable slot.
+pub static FORCED: AtomicU32 = AtomicU32::new(0);
+/// No free bob record for a found slot.
+pub static NO_BOB: AtomicU32 = AtomicU32::new(0);
+
+pub fn reset() {
+    for c in [&DRAW, &DRAW_DROPPED, &HITBOXES, &HITBOX_DROPPED, &FIND_FAIL, &EVICT, &FORCED, &NO_BOB] {
+        c.store(0, Relaxed);
+    }
+}
+
+pub fn wide() -> bool {
+    WIDE.load(Relaxed)
+}
+
+pub fn free() -> bool {
+    FREE.load(Relaxed)
+}
+
+pub fn bump(c: &AtomicU32) {
+    c.fetch_add(1, Relaxed);
+}
+
+/// Slots to loop over: the original's 20, then the extras in wide mode.
+pub fn n_slots() -> u32 {
+    if wide() { 20 + extra() } else { 20 }
+}
+
+pub fn slot(k: u32) -> u32 {
+    if k < 20 {
+        crate::level::objects::OBJ_SLOTS + k * 0x7c
+    } else {
+        SLOTS_AT + (k - 20) * 0x7c
+    }
+}
+
+pub fn slots() -> impl Iterator<Item = u32> {
+    (0..n_slots()).map(slot)
+}
+
+/// The extra bob record `k` (the long before it is its level position).
+pub fn extra_bob(k: u32) -> u32 {
+    BOBS_AT + 4 + k * 0x11c
+}
+
+/// FREE while a bob record of the extra range is being drawn or erased.
+pub struct Guard;
+
+impl Guard {
+    pub fn of(addr: u32) -> Option<Guard> {
+        (addr >= BASE && addr < BASE + BYTES).then(|| {
+            FREE.store(true, Relaxed);
+            Guard
+        })
+    }
+}
+
+impl Drop for Guard {
+    fn drop(&mut self) {
+        FREE.store(false, Relaxed);
+    }
+}
diff --git a/engine/crates/sf-plan/examples/wide_spike.rs b/engine/crates/sf-plan/examples/wide_spike.rs
new file mode 100644
index 0000000..36365f6
--- /dev/null
+++ b/engine/crates/sf-plan/examples/wide_spike.rs
@@ -0,0 +1,250 @@
+//! real-widescreen T00 spike (THROWAWAY): each level's app-timed finishing route replayed on the
+//! engine from its app start, in 4:3 and with `sf_core::spike::WIDE` on, logging per frame the
+//! live object slots, draw-list and hitbox entries and the spawn failures.
+//! `cargo run --release -p sf-plan --example wide_spike -- ROUTES_DIR SCRIPTS_DIR [LEVEL…]`
+
+use std::panic::{AssertUnwindSafe, catch_unwind};
+use std::path::Path;
+use std::sync::atomic::Ordering::Relaxed;
+
+use sf_conform::InputScript;
+use sf_core::frog::{FROG, f};
+use sf_core::spike;
+use sf_core::{Game, LevelId};
+use sf_plan::app::{app_start, route_seed};
+use sf_plan::oracle::Look;
+const HEARTS: u32 = sf_core::layout::h0(0x830);
+
+#[derive(Default, Debug)]
+struct Row {
+    frames: u32,
+    exit: Option<u32>,
+    lives_lost: u32,
+    peak_live: u32,
+    peak_at: u32,
+    peak_draw: u32,
+    draw_at: u32,
+    peak_hit: u32,
+    hit_at: u32,
+    fails: u32,
+    evicts: u32,
+    forced: u32,
+    no_bob: u32,
+    draw_dropped: u32,
+    hit_dropped: u32,
+    over20_frames: u32,
+    panic: Option<String>,
+    lead_exit: Option<u32>,
+    census: String,
+    peak_far: u32,
+    peak_near: u32,
+    near_at: u32,
+    near_census: String,
+    far_at: u32,
+}
+
+const CAMERA_X: u32 = sf_core::layout::h0(0x16664);
+const CAMERA_Y: u32 = sf_core::layout::h0(0x16660);
+
+/// Live slots by where they are against the camera: inside the original's live band
+/// (x in cx-$30-64 .. cx+$170, y in cy-$30-64 .. cy+$150), in the wide band only, or past both.
+fn bands(g: &Game) -> Vec<(u32, i32, i32, &'static str)> {
+    let st = g.state();
+    let (cx, cy) = (st.w(CAMERA_X + 2) as i16 as i32, st.w(CAMERA_Y + 2) as i16 as i32);
+    spike::slots()
+        .filter(|&s| st.l(s + 0x40) != 0)
+        .map(|s| {
+            let (x, y) = (st.w(s + 8) as i16 as i32 - cx, st.w(s + 0xa) as i16 as i32 - cy);
+            let yin = (-0x30 - 64..=0x150).contains(&y);
+            let band = if (-0x30 - 64..=0x170).contains(&x) && yin {
+                "orig"
+            } else if (-0x30 - 64 - 65..=0x170 + 65).contains(&x) && yin {
+                "wide"
+            } else {
+                "far"
+            };
+            (st.l(s + 4).wrapping_sub(sf_core::layout::h0(0)), x, y, band)
+        })
+        .collect()
+}
+
+fn census(g: &Game) -> String {
+    let b = bands(g);
+    let n = |w: &str| b.iter().filter(|e| e.3 == w).count();
+    let mut far: Vec<String> = b.iter().filter(|e| e.3 == "far").map(|e| format!("${:x}@{},{}", e.0, e.1, e.2)).collect();
+    far.truncate(6);
+    format!("orig {} wide {} far {} [{}]", n("orig"), n("wide"), n("far"), far.join(" "))
+}
+
+fn census_far(g: &Game) -> u32 {
+    bands(g).iter().filter(|e| e.3 == "far").count() as u32
+}
+
+fn live(g: &Game) -> u32 {
+    spike::slots().filter(|&s| g.state().l(s + 0x40) != 0).count() as u32
+}
+
+/// `ghost`: a 4:3 game is stepped alongside and the wide game's frog block and hearts are set
+/// from it after every frame, so the wide camera travels the 4:3 route whatever the enemies do.
+fn run(level: LevelId, seed: u32, script: &InputScript, frames: u32, lives: Option<u16>, wide: bool, ghost: bool) -> Row {
+    spike::WIDE.store(wide, Relaxed);
+    spike::reset();
+    let mut r = Row::default();
+    let mut k = 0u32;
+    let res = catch_unwind(AssertUnwindSafe(|| {
+        let mut g = app_start(level, seed);
+        let mut lead = ghost.then(|| app_start(level, seed));
+        if let Some(n) = lives {
+            g.poke(FROG + f::LIVES, &n.to_be_bytes());
+            if let Some(l) = lead.as_mut() {
+                l.poke(FROG + f::LIVES, &n.to_be_bytes());
+            }
+        }
+        let mut before = Look::of(g.state());
+        while k < frames {
+            if let Some(l) = lead.as_mut() {
+                spike::WIDE.store(false, Relaxed);
+                let (fails, ev, fo, nb, dd, hd) = (
+                    spike::FIND_FAIL.load(Relaxed), spike::EVICT.load(Relaxed), spike::FORCED.load(Relaxed),
+                    spike::NO_BOB.load(Relaxed), spike::DRAW_DROPPED.load(Relaxed), spike::HITBOX_DROPPED.load(Relaxed),
+                );
+                l.step_unseen(script.input_at(k));
+                spike::FIND_FAIL.store(fails, Relaxed);
+                spike::EVICT.store(ev, Relaxed);
+                spike::FORCED.store(fo, Relaxed);
+                spike::NO_BOB.store(nb, Relaxed);
+                spike::DRAW_DROPPED.store(dd, Relaxed);
+                spike::HITBOX_DROPPED.store(hd, Relaxed);
+                spike::DRAW.store(0, Relaxed);
+                spike::HITBOXES.store(0, Relaxed);
+                spike::WIDE.store(true, Relaxed);
+            }
+            g.step_unseen(script.input_at(k));
+            if let Some(l) = lead.as_ref() {
+                let frog: Vec<u8> = (0..0x100).map(|o| l.state().b(FROG + o)).collect();
+                g.poke(FROG, &frog);
+                g.poke(HEARTS, &l.state().w(HEARTS).to_be_bytes());
+                if !Look::of(l.state()).playing && k > 10 {
+                    r.lead_exit.get_or_insert(k + 1);
+                }
+            }
+            k += 1;
+            if std::env::var("SPIKE_TRACE").is_ok() && !ghost && (k % 250 == 0 || k + 3 >= frames) {
+                let st = g.state();
+                eprintln!("  {level} k {k} frog {},{} cam {} state {:x} coins_left {}", st.w(FROG + f::X) as i16, st.w(FROG + f::Y) as i16, st.w(CAMERA_X + 2), st.l(sf_core::layout::h0(0xa06)), st.w(sf_core::layout::h0(0x832)));
+            }
+            let now = Look::of(g.state());
+            r.lives_lost += before.lives.saturating_sub(now.lives) as u32;
+            before = now;
+            let n = live(&g);
+            if n > r.peak_live {
+                (r.peak_live, r.peak_at) = (n, k);
+                r.census = census(&g);
+            }
+            let near = n - census_far(&g);
+            if near > r.peak_near {
+                (r.peak_near, r.near_at) = (near, k);
+                r.near_census = census(&g);
+            }
+            let far = census_far(&g);
+            if far > r.peak_far {
+                (r.peak_far, r.far_at) = (far, k);
+            }
+            if n > 20 {
+                r.over20_frames += 1;
+            }
+            let d = spike::DRAW.swap(0, Relaxed);
+            if d > r.peak_draw {
+                (r.peak_draw, r.draw_at) = (d, k);
+            }
+            let h = spike::HITBOXES.swap(0, Relaxed);
+            if h > r.peak_hit {
+                (r.peak_hit, r.hit_at) = (h, k);
+            }
+            if k > 10 && !now.playing {
+                r.exit = Some(k);
+                break;
+            }
+        }
+    }));
+    r.frames = k;
+    if let Err(e) = res {
+        let msg = e
+            .downcast_ref::<String>()
+            .cloned()
+            .or_else(|| e.downcast_ref::<&str>().map(|s| s.to_string()))
+            .unwrap_or_default();
+        r.panic = Some(format!("frame {k}: {msg}"));
+    }
+    r.fails = spike::FIND_FAIL.load(Relaxed);
+    r.evicts = spike::EVICT.load(Relaxed);
+    r.forced = spike::FORCED.load(Relaxed);
+    r.no_bob = spike::NO_BOB.load(Relaxed);
+    r.draw_dropped = spike::DRAW_DROPPED.load(Relaxed);
+    r.hit_dropped = spike::HITBOX_DROPPED.load(Relaxed);
+    spike::WIDE.store(false, Relaxed);
+    r
+}
+
+fn main() {
+    std::panic::set_hook(Box::new(|_| {}));
+    if let Ok(n) = std::env::var("SPIKE_EXTRA") {
+        spike::EXTRA_N.store(n.parse().unwrap(), Relaxed);
+    }
+    let args: Vec<String> = std::env::args().skip(1).collect();
+    let routes = Path::new(&args[0]);
+    let scripts = Path::new(&args[1]);
+    let all: Vec<String> = (1..=6)
+        .flat_map(|w| (1..=4).map(move |l| format!("W{w}-{l}")))
+        .chain(["WB-1".to_string(), "WW-1".to_string()])
+        .collect();
+    let levels: Vec<String> = if args.len() > 2 { args[2..].to_vec() } else { all };
+    println!("level\tmode\tsource\tframes\texit\tlives_lost\tpeak_live\tpeak_at\tpeak_draw\tdraw_at\tpeak_hitbox\thit_at\tframes_over20\tfind_free_fail\tevict\tcoin_forced\tno_bob\tdraw_dropped\thit_dropped\tpanic\tpeak_far\tfar_at\tcensus_at_peak\tpeak_near\tnear_at\tcensus_at_near");
+    for name in levels {
+        let level: LevelId = name.parse().unwrap();
+        // The bonus level: bonus-fire with 60 lives (bonus-end-wb-1's case); the final level:
+        // final-win. Both from their app start, seed 1.
+        let (src, text, frames, lives) = match name.as_str() {
+            "WB-1" => ("bonus-fire.txt", std::fs::read_to_string(scripts.join("bonus-fire.txt")).unwrap(), 8400, Some(60)),
+            "WW-1" => ("final-win.txt", std::fs::read_to_string(scripts.join("final-win.txt")).unwrap(), 2600, None),
+            _ => {
+                let p = routes.join(format!("{name}.txt"));
+                let t = std::fs::read_to_string(&p).unwrap();
+                ("app route", t, 0, None)
+            }
+        };
+        let script = InputScript::parse(&text).unwrap();
+        let seed = route_seed(&text).unwrap_or(1);
+        let frames = if frames == 0 { script.lines.last().map_or(0, |l| l.0) + 300 } else { frames };
+        for (wide, ghost) in [(false, false), (true, false), (true, true)] {
+            let r = run(level, seed, &script, frames, lives, wide, ghost);
+            println!(
+                "{name}\t{}\t{src}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}",
+                match (wide, ghost) { (false, _) => "4:3", (true, false) => "wide", _ => "wide-ghost" },
+                r.frames,
+                r.exit.map_or("-".into(), |e| e.to_string()),
+                r.lives_lost,
+                r.peak_live,
+                r.peak_at,
+                r.peak_draw,
+                r.draw_at,
+                r.peak_hit,
+                r.hit_at,
+                r.over20_frames,
+                r.fails,
+                r.evicts,
+                r.forced,
+                r.no_bob,
+                r.draw_dropped,
+                r.hit_dropped,
+                r.panic.unwrap_or("-".into()),
+                r.peak_far,
+                r.far_at,
+                r.census,
+                r.peak_near,
+                r.near_at,
+                r.near_census
+            );
+        }
+    }
+}
