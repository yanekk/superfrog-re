new file mode 100644
index 0000000..9d108c2
--- /dev/null
+++ b/engine/crates/sf-conform/examples/t33_blit_probe.rs
@@ -0,0 +1,28 @@
+//! Scratch (T33): the original's blit events on given frames of a power-on case.
+use sf_conform::{Case, sync};
+fn main() {
+    let a: Vec<String> = std::env::args().skip(1).collect();
+    let case = Case::load(std::path::Path::new(&a[0])).unwrap();
+    let frames: Vec<u32> = a[1..].iter().map(|x| x.parse().unwrap()).collect();
+    let last = *frames.iter().max().unwrap();
+    let s = sync::reach(&case.sync, &case.script, last + 20000).unwrap();
+    let mut am = s.amiga;
+    for f in 0..=last {
+        let cap = sync::step_inserting(&mut am, case.script.input_at(f)).unwrap();
+        if frames.contains(&f) {
+            let p = &cap.picture;
+            println!("  window {:x},{:x} {}x{} px(25,15)={:03x} px(25,60)={:03x}", p.left, p.top, p.width, p.height, p.pixel(25, 15), p.pixel(25, 60));
+            println!("== {f}");
+            let ov = am.peek(sf_core::layout::h0(0xb6f0), 4);
+            println!("  b6f0 {:02x?} h3 base {:x}", ov, sf_core::layout::h3(0));
+            let a: u32 = std::env::var("T33_ADDR").ok().and_then(|v| u32::from_str_radix(&v, 16).ok()).unwrap_or(0x6fd0);
+            let m = am.peek(a, 0x100);
+            let w: Vec<String> = m.chunks(4).map(|c| format!("{:02x}{:02x}:{:02x}{:02x}", c[0], c[1], c[2], c[3])).collect();
+            println!("  list {:x} {}", a, w.join(" "));
+            for e in am.blit_events() {
+                println!("  {:?}", e);
+            }
+            for w in am.cpu_writes() { if [0x80u16,0x82,0x88,0x8e,0x90,0x92,0x94,0x100].contains(&w.reg) { println!("  cpu {:x}={:x} at {} {}", w.reg, w.value, w.vpos, w.hpos); } }
+        }
+    }
+}
diff --git a/engine/crates/sf-conform/examples/t33_irqs.rs b/engine/crates/sf-conform/examples/t33_irqs.rs
new file mode 100644
index 0000000..3571380
--- /dev/null
+++ b/engine/crates/sf-conform/examples/t33_irqs.rs
@@ -0,0 +1,20 @@
+//! Scratch (T33): the original's interrupts per frame (by level) over frames `from..to` of a case.
+use sf_conform::{Case, sync};
+fn main() {
+    let a: Vec<String> = std::env::args().skip(1).collect();
+    let case = Case::load(std::path::Path::new(&a[0])).unwrap();
+    let from: u32 = a[1].parse().unwrap();
+    let to: u32 = a[2].parse().unwrap();
+    let s = sync::reach(&case.sync, &case.script, to + 20000).unwrap();
+    let mut am = s.amiga;
+    for f in 0..to {
+        sync::step_inserting(&mut am, case.script.input_at(f)).unwrap();
+        if f >= from {
+            let mut n = [0u32; 8];
+            for i in am.irqs() {
+                n[i.level as usize & 7] += 1;
+            }
+            println!("{f} irqs by level {:?}", n);
+        }
+    }
+}
diff --git a/engine/crates/sf-conform/examples/t33_writes.rs b/engine/crates/sf-conform/examples/t33_writes.rs
new file mode 100644
index 0000000..3d0f381
--- /dev/null
+++ b/engine/crates/sf-conform/examples/t33_writes.rs
@@ -0,0 +1,26 @@
+//! Scratch (T33): both sides' non-audio Paula writes (DMACON, INTENA, INTREQ...) per frame of a
+//! case, for frames `from..to`. `t33_writes <case> <from> <to>`
+use sf_conform::Case;
+fn main() {
+    let a: Vec<String> = std::env::args().skip(1).collect();
+    let case = Case::load(std::path::Path::new(&a[0])).unwrap();
+    let from: u32 = a[1].parse().unwrap();
+    let to: u32 = a[2].parse().unwrap();
+    let show = |ws: &[sf_paula::PaulaWrite]| {
+        ws.iter()
+            .filter(|w| !(0xa0..0xe0).contains(&w.reg))
+            .map(|w| format!("{:02x}={:04x}@{}.{}", w.reg, w.value, w.vpos, w.hpos))
+            .collect::<Vec<_>>()
+            .join(" ")
+    };
+    let r = sf_conform::run_observing(&case, |f, ours, theirs| {
+        if (from..to).contains(&f) {
+            println!("{f} O: {}", show(theirs));
+            println!("{f} E: {}", show(ours));
+        }
+    });
+    match r {
+        Ok(_) => println!("ok"),
+        Err(d) => println!("{d}"),
+    }
+}
